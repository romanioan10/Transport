# Copy to .env, then supply your own random secret of at least 32 UTF-8 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Defaults match the existing local PostgreSQL database.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret
POSTGRES_DB=logistics
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Enable only for initial provisioning, then disable and remove the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
